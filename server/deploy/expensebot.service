[Unit]
Description=exbotweb Telegram expense bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=expensebot
Group=expensebot
WorkingDirectory=/opt/exbotweb/server
EnvironmentFile=/opt/exbotweb/server/.env
ExecStart=/usr/bin/node /opt/exbotweb/server/dist/main.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
